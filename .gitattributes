# Normalize line endings across macOS / Windows / Linux.
* text=auto eol=lf

# Godot text resources
*.gd    text
*.tscn  text
*.tres  text
*.godot text
*.cfg   text
*.import text

# Binary assets — never diff/merge or convert line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.svg  text
*.glb  binary
*.gltf binary
*.blend binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary

# If large binary assets are added later, track them with Git LFS, e.g.:
#   *.glb  filter=lfs diff=lfs merge=lfs -text
